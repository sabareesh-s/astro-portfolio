---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlurCircle from "@/components/shared/BlurCircle.astro";
import theme from "@/data/theme";
import SEOTags from "@/components/seo/SEOTags.astro";
import type { HeadTags } from "@/utils/types/HeadTags";

import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@/styles/tailwind.css";

export type Props = HeadTags;

const headTags = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <SEOTags {...headTags} />

  <body
    class="mx-auto flex min-h-screen max-w-[1200px] flex-col gap-10 bg-page px-4 py-7 text-sm text-body sm:px-8 md:gap-20 md:px-10 md:py-16"
  >
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem("theme") === "light")
          document.documentElement.classList.add("light");
      } catch (e) {}
    </script>
    <Header />
    <BlurCircle position="top" color={theme.colors.blur.top} />
    <BlurCircle position="bottom" color={theme.colors.blur.bottom} />
    <slot />
    <Footer />
    <style is:global>
      html {
        font-family: "Inter", sans-serif;
      }

      /* Theme tokens — dark is the default; html.light flips them */
      :root {
        --c-page: 20 20 20;
        --c-surface: 30 30 30;
        --c-hair: 44 44 44;
        --c-hair-strong: 66 66 66;
        --c-ink: 237 237 237;
        --c-ink-soft: 198 198 198;
        --c-body: 158 158 158;
        --c-muted: 122 122 122;
        --c-accent: 245 158 11;
        --dot: 255 255 255;
      }

      html.light {
        --c-page: 245 244 241;
        --c-surface: 251 250 248;
        --c-hair: 228 225 219;
        --c-hair-strong: 212 208 200;
        --c-ink: 42 42 40;
        --c-ink-soft: 74 74 70;
        --c-body: 107 107 101;
        --c-muted: 150 148 139;
        --c-accent: 194 97 6;
        --dot: 30 30 30;
      }

      /* Animate the palette when switching themes.
         :where() keeps specificity at 0 so element-level transitions
         (transition-all / transition-colors, reveals) always win. */
      @media (prefers-reduced-motion: no-preference) {
        :where(body, body *) {
          transition: background-color 0.45s ease, border-color 0.45s ease,
            color 0.45s ease, fill 0.45s ease;
        }
      }

      /* Theme toggle icon swap */
      .theme-toggle .moon {
        display: none;
      }
      html.light .theme-toggle .sun {
        display: none;
      }
      html.light .theme-toggle .moon {
        display: block;
      }

      /* Atmosphere: a fixed, gently masked dot-grid for depth */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image: radial-gradient(
          rgb(var(--dot) / 0.05) 1px,
          transparent 1px
        );
        background-size: 24px 24px;
        -webkit-mask-image: radial-gradient(
          115% 85% at 50% 0%,
          #000 35%,
          transparent 85%
        );
        mask-image: radial-gradient(
          115% 85% at 50% 0%,
          #000 35%,
          transparent 85%
        );
      }

      /* Motion: orchestrated entrance reveals (progressive-enhancement only) */
      @media (prefers-reduced-motion: no-preference) {
        .js [data-reveal] {
          opacity: 0;
          transform: translateY(16px);
          transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
          transition-delay: var(--reveal-delay, 0ms);
          will-change: opacity, transform;
        }
        .js [data-reveal].is-visible {
          opacity: 1;
          transform: none;
        }
      }
    </style>
    <script>
      const canMotion = window.matchMedia(
        "(prefers-reduced-motion: no-preference)"
      ).matches;
      const els = Array.from(document.querySelectorAll("[data-reveal]"));
      if (!canMotion || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
        );
        els.forEach((el) => io.observe(el));
      }

      // Theme toggle
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const isLight = document.documentElement.classList.toggle("light");
        try {
          localStorage.setItem("theme", isLight ? "light" : "dark");
        } catch (e) {}
      });
    </script>
  </body>
</html>
