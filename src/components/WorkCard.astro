---
import type { Project } from "@/data/projects";

type Props = Project & { featured?: boolean };

const { title, description, image, techs, link, featured, note } = Astro.props;

const formatTechs = (values: string[]) => values.join(" · ");
---

<a
  href={link}
  target="_blank"
  rel="noreferrer"
  class="group flex flex-col overflow-hidden rounded-xl border border-hair bg-surface/60 transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-[0_16px_50px_-20px_rgba(245,158,11,0.35)]"
>
  <div
    class:list={[
      "relative overflow-hidden bg-hair",
      featured ? "aspect-[21/9]" : "aspect-[16/10]",
    ]}
  >
    {
      image && (
        <img
          src={image}
          alt={`Screenshot of ${title}`}
          loading="lazy"
          class="h-full w-full object-cover object-top"
        />
      )
    }
    <div
      class="absolute inset-0 flex items-end justify-end bg-gradient-to-t from-black/50 via-transparent to-transparent p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >
      <span
        class="rounded-full bg-white px-3 py-1 font-mono text-[11px] font-medium text-black"
      >
        Visit ↗
      </span>
    </div>
  </div>

  <div class="flex flex-col gap-1.5 p-4">
    <p
      class:list={[
        "font-display font-medium text-ink",
        featured ? "text-lg" : "text-base",
      ]}
    >
      {title}
    </p>
    {description && <p class="text-sm leading-5 text-body">{description}</p>}
    {note && <p class="text-[11px] leading-4 text-muted">{note}</p>}
    <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-accent/90">
      {formatTechs(techs)}
    </p>
  </div>
</a>
